/.gitignore text eol=lf
/.gitattributes text eol=lf
# Keep shell scripts Linux-compatible
*.sh text eol=lf
*.bash text eol=lf

# Keep Windows scripts Windows-compatible
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# General text files
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
